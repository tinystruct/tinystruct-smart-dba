<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven settings for publishing to GitHub Packages.
     Usage: GITHUB_ACTOR=<user> GITHUB_TOKEN=<token with write:packages> ./mvnw deploy -s .mvn/github-settings.xml
     Holds no secrets: credentials come from the environment. -->
<settings>
    <servers>
        <server>
            <id>github</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
    </servers>
</settings>
